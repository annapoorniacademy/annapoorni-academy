# ==============================================================================
# Annapoorni Academy V2.0 — Environment Variables Template
# Ultra-Low-Cost Google Cloud Run + Firestore Deployment
# NEVER commit real passwords, API keys, or private secrets to version control!
# ==============================================================================

# Server & Runtime Configuration
FLASK_ENV=production
PORT=8080
SECRET_KEY=change_this_to_a_random_cryptographic_secret_string
JWT_SECRET_KEY=change_this_to_a_random_jwt_secret_signing_key
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Production Domain & CORS Origin (Single domain deployment)
FRONTEND_URL=https://annapoorniacademy.com,https://www.annapoorniacademy.com

# Database Configuration (Option A: Google Cloud Firestore - Free Tier, Scale-to-Zero)
DB_TYPE=firestore
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)

# Database Configuration (Option B: SQL fallback / local SQLite / MySQL)
# Leave empty to use default local SQLite (sqlite:///annapoorni.db) or provide MySQL URI:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# Media Storage Configuration (Google Cloud Storage minimal bucket or local container storage)
STORAGE_BUCKET=your-academy-media-bucket
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=5242880

# Static Build Assets Path (Used when serving React SPA from Flask on Cloud Run)
STATIC_FOLDER=/app/frontend/dist

# Initial Admin Seeding Credentials (Only used during initial database initialization)
ADMIN_USERNAME=admin
ADMIN_EMAIL=coach.sindhuram@gmail.com
ADMIN_PASSWORD=change_this_to_a_strong_password_before_first_run

# ==============================================================================
# Official Gmail SMTP Email Integration
# Sender & Recipient: coach.sindhuram@gmail.com
# Port: 587 (STARTTLS) | Server: smtp.gmail.com
# Authentication: Use a 16-character Google App Password (with 2FA enabled)
# Note: Submissions are ALWAYS saved to Firestore/DB even if SMTP is unconfigured.
# ==============================================================================
MAIL_PROVIDER=gmail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=coach.sindhuram@gmail.com
MAIL_PASSWORD=
MAIL_FROM=coach.sindhuram@gmail.com
MAIL_FROM_NAME=Annapoorni Academy
ADMIN_EMAIL=coach.sindhuram@gmail.com
